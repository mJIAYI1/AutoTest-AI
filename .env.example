MYSQL_DATABASE=autotest_ai
MYSQL_USER=autotest
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3307
SERVER_PORT=18080
FRONTEND_PORT=5173
DEMO_API_PORT=8081
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=autotest-ai
JWT_EXPIRATION=PT2H
OPENAPI_IMPORT_ALLOWED_HOSTS=localhost,127.0.0.1
OPENAPI_IMPORT_MAX_BYTES=5242880
OPENAPI_IMPORT_CONNECT_TIMEOUT=PT5S
OPENAPI_IMPORT_READ_TIMEOUT=PT15S
DOCKER_OPENAPI_IMPORT_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,demo-api
TEST_EXECUTION_ALLOWED_HOSTS=localhost,127.0.0.1
DOCKER_TEST_EXECUTION_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,demo-api
TEST_EXECUTION_CONNECT_TIMEOUT=PT5S
TEST_EXECUTION_READ_TIMEOUT=PT15S
TEST_EXECUTION_MAX_RESPONSE_BYTES=1048576
TEST_EXECUTION_CORE_POOL_SIZE=2
TEST_EXECUTION_MAX_POOL_SIZE=4
TEST_EXECUTION_QUEUE_CAPACITY=100
TEST_SUITE_MAX_CASES=50
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Phase 3A: both API key and model are required to enable AI test generation.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=
SILICONFLOW_MAX_TOKENS=4096
SILICONFLOW_TIMEOUT=PT90S
